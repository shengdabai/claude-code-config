{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "_comment": "Claude Code 优化配置 - 复制到 ~/.claude/settings.json",
    "permissions": {
        "defaultMode": "acceptEdits",
        "allow": [
            "Read",
            "Edit",
            "Write",
            "Bash(git *)",
            "Bash(npm *)",
            "Bash(pnpm *)",
            "Bash(yarn *)",
            "Bash(node *)",
            "Bash(python *)",
            "Bash(python3 *)",
            "Bash(pip *)",
            "Bash(pip3 *)",
            "Bash(ls *)",
            "Bash(cat *)",
            "Bash(grep *)",
            "Bash(find *)",
            "Bash(mkdir *)",
            "Bash(rm *)",
            "Bash(cp *)",
            "Bash(mv *)",
            "Bash(cd *)",
            "Bash(pwd)",
            "Bash(echo *)",
            "Bash(touch *)",
            "Bash(chmod *)",
            "Bash(curl *)",
            "Bash(wget *)",
            "Bash(npx *)",
            "Bash(tsx *)",
            "Bash(tsc *)",
            "Bash(eslint *)",
            "Bash(prettier *)",
            "Bash(jest *)",
            "Bash(vitest *)",
            "Bash(pytest *)",
            "Bash(brew *)",
            "Bash(code *)",
            "Bash(open *)",
            "WebFetch"
        ]
    },
    "cleanupPeriodDays": 30,
    "spinnerTipsEnabled": true,
    "alwaysThinkingEnabled": true,
    "promptSuggestionEnabled": true,
    "attribution": {
        "commit": "Co-authored-by: Claude <noreply@anthropic.com>",
        "pr": "Generated with Claude Code"
    }
}